    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.wrinkle.laundry",
    "productName": "Wrinkle Laundry Command Center",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
