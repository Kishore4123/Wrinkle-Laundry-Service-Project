{
  "name": "wrinkle-laundry-command-center",
  "version": "1.0.0",
  "description": "Wrinkle Release Laundry Service Command Center",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Wrinkle Laundry",
